# ==================================================
# Swiss Property Management Platform - Environment Variables
# Copy this file to .env and fill in your values
# ==================================================

# Django
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-use-at-least-50-chars

# Database (PostgreSQL)
DB_NAME=immo_accounting
DB_USER=immo_user
DB_PASSWORD=immo_password
DB_HOST=localhost
DB_PORT=5432

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Storage (set USE_S3=True to use S3-compatible storage)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com

# Open Banking (bLink by SIX)
BLINK_API_KEY=
BLINK_API_BASE_URL=https://api.six-group.com/

# UBS Open Banking
UBS_CLIENT_ID=
UBS_CLIENT_SECRET=
UBS_API_BASE_URL=

# OCR / AI
# Supports: tesseract (local), azure (Azure Cognitive Services), openai (GPT-4 Vision)
OCR_PROVIDER=tesseract
AZURE_COGNITIVE_SERVICES_KEY=
AZURE_COGNITIVE_SERVICES_ENDPOINT=
OPENAI_API_KEY=

# Email notifications
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@immo-manager.ch

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
