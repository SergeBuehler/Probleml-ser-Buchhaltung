# ==================================================
# Produktion — Hetzner Server
# Datei: /opt/immo/.env
# ==================================================

# Domain (ohne https://)
DOMAIN=immo.deine-domain.ch

# Django
DEBUG=False
SECRET_KEY=hier-einen-langen-zufaelligen-schluessel-einsetzen-min-50-zeichen

# Datenbank
DB_NAME=immo_accounting
DB_USER=immo_user
DB_PASSWORD=sicheres-passwort-hier
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Dokument-Speicherung
# Option A: Lokal (Standard, im Docker-Volume)
USE_S3=False

# Option B: Cloudflare R2 (empfohlen für Produktion)
# USE_S3=True
# AWS_ACCESS_KEY_ID=dein-r2-access-key
# AWS_SECRET_ACCESS_KEY=dein-r2-secret-key
# AWS_STORAGE_BUCKET_NAME=immo-dokumente
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# E-Mail (für Benachrichtigungen)
EMAIL_HOST=smtp.infomaniak.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@deine-domain.ch
EMAIL_HOST_PASSWORD=email-passwort

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
